
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                bat 'npm install'
                bat 'npm run build'
            }
        }

        stage('Test') {
            steps {
                bat 'npm test'
            }
        }

        stage('Deploy') {
            when {
                branch 'master'
            }
            steps {
                bat 'docker build -t myapp:latest .'
                bat 'docker push myapp:latest'
            }
        }
    }
}
