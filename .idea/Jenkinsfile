
pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'twoj-login/node-app'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Pobieranie kodu z repozytorium...'
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Instalowanie zaleznosci...'
                bat 'npm install'
            }
        }

        stage('Run Tests') {
            steps {
                echo 'Uruchamianie testow...'
                bat 'npm test'
            }
        }

        stage('Build Application') {
            steps {
                echo 'Budowanie aplikacji...'
                bat 'npm run build'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Budowanie obrazu Docker...'
                bat 'docker build -t %DOCKER_IMAGE%:%BUILD_NUMBER% .'
            }
        }

        stage('Push Docker Image') {
            steps {
                echo 'Publikowanie obrazu Docker...'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    bat 'echo %DOCKER_PASS%| docker login -u %DOCKER_USER% --password-stdin'
                    bat 'docker push %DOCKER_IMAGE%:%BUILD_NUMBER%'
                    bat 'docker logout'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline zakonczony sukcesem!'
        }

        failure {
            echo 'Pipeline zakonczony niepowodzeniem!'
        }

        always {
            echo 'Zakonczono wykonywanie pipeline.'
        }
    }
}
